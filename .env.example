# Public (shown in the browser by design) --------------------------------
# Canonical site origin, no trailing slash. Required for sitemap/canonical/hreflang.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# International digits only, e.g. 201XXXXXXXXX. Empty = WhatsApp shows "PENDING". Defaults to the first phone.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Official phone / WhatsApp numbers, comma-separated, primary first (each gets call + WhatsApp links).
NEXT_PUBLIC_PHONE_NUMBERS=
# Public e-mails shown on the site. Empty = "PENDING".
NEXT_PUBLIC_GENERAL_EMAIL=
NEXT_PUBLIC_EXPORT_EMAIL=
# Set to true ONLY at launch. Until then robots.txt disallows everything and pages carry noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Version label of the privacy/consent text shown with the RFQ form.
NEXT_PUBLIC_CONSENT_TEXT_VERSION=PENDING

# Server only (never exposed to the browser) ------------------------------
# RFQ delivery via Resend. If any of these is missing, POST /api/rfq answers 503 not_configured
# and the form reports "Request not sent" — it never fakes success.
RESEND_API_KEY=
RFQ_TO_EMAIL=
RFQ_FROM_EMAIL=
# Rate limit per client IP (in-memory, per server instance).
RFQ_RATE_LIMIT_MAX=5
RFQ_RATE_LIMIT_WINDOW_SECONDS=600
