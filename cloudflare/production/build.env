# Build-time (public) values for the Cloudflare PRODUCTION build. No secrets here.
# NEXT_PUBLIC_* values are inlined at build time; change → rebuild.
# The production build refuses to run while any value below is empty or PENDING (cloudflare/shared/build.sh).
#
# Canonical origin (owner decision: apex shown; switch to https://www.alnasrfurniture.com if www is chosen).
NEXT_PUBLIC_SITE_URL="https://alnasrfurniture.com"
# Owner-supplied (see docs/production/cloudflare-production/01-owner-information-required.md):
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_CONSENT_TEXT_VERSION=
# Stays false until launch. true also needs CF_CONFIRM_INDEXING=yes and the runtime var ALLOW_INDEXING="true".
NEXT_PUBLIC_ALLOW_INDEXING=false
