# Build-time (public) values for the Cloudflare PRODUCTION build. No secrets here.
# NEXT_PUBLIC_* values are inlined at build time; change → rebuild.
# The production build refuses to run without the required values (cloudflare/shared/build.sh).
#
# Canonical origin: the apex; www redirects to it.
NEXT_PUBLIC_SITE_URL="https://alnasrfurniture.com"
# MVP launch: online RFQ is OFF until Resend e-mail delivery is set up. The form shows a notice with the contact
# links below and never submits. Switch to true only together with the Resend secrets and the consent version.
NEXT_PUBLIC_RFQ_ENABLED=false
# Official contact details (owner-approved 2026-11-26). Phones are international digits, primary first;
# each is shown with call and WhatsApp links. WhatsApp CTAs use NEXT_PUBLIC_WHATSAPP_NUMBER.
# At least ONE contact channel while RFQ is off (WhatsApp + general e-mail + consent once RFQ is on).
NEXT_PUBLIC_WHATSAPP_NUMBER=201070051752
NEXT_PUBLIC_PHONE_NUMBERS=201070051752,201201883456
NEXT_PUBLIC_GENERAL_EMAIL=contact@alnasrfurniture.com
NEXT_PUBLIC_EXPORT_EMAIL=export@alnasrfurniture.com
# Required only when NEXT_PUBLIC_RFQ_ENABLED=true:
NEXT_PUBLIC_CONSENT_TEXT_VERSION=
# Stays false until the owner approves indexing. true also needs CF_CONFIRM_INDEXING=yes and the runtime var
# ALLOW_INDEXING="true" in wrangler.production.jsonc.
NEXT_PUBLIC_ALLOW_INDEXING=false
