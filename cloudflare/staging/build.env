# Build-time (public) values for the Cloudflare STAGING build. No secrets here.
# NEXT_PUBLIC_* values are inlined at build time; change → rebuild.
# Replace alnasr-staging with your workers.dev subdomain (Cloudflare dashboard → Workers & Pages → Account details).
NEXT_PUBLIC_SITE_URL="https://al-nasr-furniture-staging.alnasr-staging.workers.dev"
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GENERAL_EMAIL=
NEXT_PUBLIC_EXPORT_EMAIL=
NEXT_PUBLIC_CONSENT_TEXT_VERSION=STAGING-TEST
